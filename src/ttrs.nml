/* Begin TTRS (NFO-translated, ITL integrated) */
switch (FEAT_HOUSES, SELF, switch_ttrs_residential, CheckValue(1,255) && IsNotDesertTile()) {return;}
switch (FEAT_HOUSES, SELF, switch_ttrs_flats, CheckValue(4,255) && CheckFlatsSprawl()) {return;}
switch (FEAT_HOUSES, SELF, switch_ttrs_offices, CheckOfficeSprawl(1000) && CheckValue(7,255) && (HasSameClassNearby(2) || IsFirstHouseOfClass())) {return;}
switch (FEAT_HOUSES, SELF, switch_ttrs_landmark, CheckValue(5,255)) {return;}
switch (FEAT_HOUSES, SELF, switch_ttrs_landmark_unique, CheckValue(5,255) && IsUniqueInRadius(10)) {return;}

item (FEAT_HOUSES, item_ttrs_00_fire_station, 200) {
	property {
		substitute: 3;
		building_flags: bitmask(HOUSE_FLAG_CHURCH);
		/* NFO building_flags extra bits: 1 */
		availability_mask: [bitmask(TOWNZONE_EDGE, TOWNZONE_OUTSKIRT, TOWNZONE_OUTER_SUBURB, TOWNZONE_INNER_SUBURB), bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC, CLIMATE_TOYLAND, ABOVE_SNOWLINE)];
		/* NFO availability packed value: 63503 */
		years_available: [1930, 1950];
	}
	graphics {
		default: sl_ttrs_00;
		construction_check: switch_ttrs_residential;
	}
}

