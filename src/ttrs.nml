	property {
		substitute: 40;
		building_flags: bitmask(HOUSE_FLAG_ANIMATE, HOUSE_FLAG_ONLY_SE, HOUSE_FLAG_PROTECTED, HOUSE_FLAG_SYNC_CALLBACK);
		availability_mask: [bitmask(TOWNZONE_EDGE, TOWNZONE_OUTSKIRT, TOWNZONE_OUTER_SUBURB, TOWNZONE_INNER_SUBURB, TOWNZONE_CENTRE), bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC, CLIMATE_TOYLAND, ABOVE_SNOWLINE)];
		/* NFO availability packed value: 63519 */
		years_available: [1930, 1990];
		building_class: 2;
		probability: 2;
		refresh_multiplier: 9;
		animation_info: [0, 24];
		/* NFO name string-id: DC16; visible name: house_88 */
		/* NFO field 14: FF */
		/* NFO field 1D: 00 */
	}
	graphics {
		default: switch_ttrs_88_tile;
		construction_check: switch_ttrs_flats;
	}
}

